# Fix Windows console UTF-8 encoding
if sys.platform == "win32":
    try:
        sys.stdout.reconfigure(encoding='utf-8')
        sys.stderr.reconfigure(encoding='utf-8')
    except Exception:
        pass

CURRENT_VERSION = "7.7.0"
CURRENT_VERSION_NAME = "TN KHMER V7.7 Pro"
MEDIAFIRE_FOLDER_URL = "https://app.mediafire.com/folder/zpsljunnnu4i7"
BLOGGER_HOMEPAGE = "https://phanthanak7.blogspot.com"

# Remote Version Manifest Endpoints (Checked in sequence)
VERSION_MANIFEST_URLS = [
    # Primary repository raw version descriptor
    "https://raw.githubusercontent.com/phanthanak/TN-KHMER-TOOL/main/version.json",
    # Alternative endpoint / Gist fallback
    "https://api.github.com/repos/phanthanak/TN-KHMER-TOOL/releases/latest"
]

def parse_version_tuple(v_str: str) -> tuple:
    """Parses a version string like '6.0', 'v6.1', '6.0.1' into integer tuple."""
    clean = v_str.lower().replace("v", "").replace("pro", "").strip()
    parts = []
    for chunk in clean.split("."):
        try:
            parts.append(int(chunk.strip()))
        except ValueError:
            parts.append(0)
    return tuple(parts) if parts else (0,)

def is_newer_version(remote_v: str, local_v: str = CURRENT_VERSION) -> bool:
    """Returns True if remote_v > local_v."""
    try:
        return parse_version_tuple(remote_v) > parse_version_tuple(local_v)
    except Exception:
        return False

def open_mediafire_download_folder():
    """Opens the official MediaFire download link in the user's default browser."""
    try:
        webbrowser.open(MEDIAFIRE_FOLDER_URL)
        return True
    except Exception as e:
        print(f"Error opening browser: {e}")
        return False


def clean_legacy_installations(current_version_name: str = CURRENT_VERSION_NAME, current_dir: str = "", log_callback=None) -> list:
    """
    Scans and automatically removes obsolete version directories, old Desktop shortcuts,
    and old Start Menu entries from earlier TN KHMER installations.
    Ensures that when upgrading, old versions are automatically deleted without
    leaving duplicate or split installations on the PC
    (លុបកំណែចាស់ៗអូតូម៉ាតិច មិនបំបែកខ្លួនចេញជាច្រើន Version ឬជាន់គ្នាឡើយ).
    """
    import shutil
    cleaned = []
    norm_cur = os.path.normcase(os.path.abspath(current_dir)) if current_dir else ""

    def _rm_readonly(func, path, exc_info):
        try:
            os.chmod(path, 0o777)
            func(path)
        except Exception:
            pass

    # 1. Clean older directories in LOCALAPPDATA
    local_appdata = os.environ.get("LOCALAPPDATA", "")
    if local_appdata and os.path.isdir(local_appdata):
        try:
            for entry in os.listdir(local_appdata):
                full_p = os.path.join(local_appdata, entry)
                if not os.path.isdir(full_p):
                    continue
                low = entry.lower()
                if low.startswith("tn khmer") or low.startswith("tn_khmer"):
                    if norm_cur and os.path.normcase(os.path.abspath(full_p)) == norm_cur:
                        continue
                    if entry.lower() == current_version_name.lower():
                        continue
                    try:
                        shutil.rmtree(full_p, onerror=_rm_readonly)
                        cleaned.append(full_p)
                        if log_callback:
                            log_callback(f"🧹 Removed old installation: {entry}")
                    except Exception as e:
                        print(f"Error removing {full_p}: {e}")
        except Exception as e:
            print(f"Error scanning localappdata: {e}")

    # 2. Clean older Desktop shortcuts
    desktop_dirs = [
        os.path.join(os.path.expanduser("~"), "Desktop"),
        os.path.join(os.environ.get("PUBLIC", "C:\\Users\\Public"), "Desktop")
    ]
    cur_lnk = f"{current_version_name}.lnk".lower()
    for desk in desktop_dirs:
        if os.path.isdir(desk):
            try:
                for f in os.listdir(desk):
                    low = f.lower()
                    if ("tn khmer" in low or "tn_khmer" in low) and low.endswith(".lnk"):
                        if low != cur_lnk:
                            p = os.path.join(desk, f)
                            try:
                                os.remove(p)
                                cleaned.append(p)
                                if log_callback:
                                    log_callback(f"🧹 Removed old shortcut: {f}")
                            except Exception:
                                pass
            except Exception:
                pass

    # 3. Clean older Start Menu shortcut folders
    appdata = os.environ.get("APPDATA", "")
    if appdata:
        start_progs = os.path.join(appdata, "Microsoft", "Windows", "Start Menu", "Programs")
        if os.path.isdir(start_progs):
            try:
                for entry in os.listdir(start_progs):
                    low = entry.lower()
                    if ("tn khmer" in low or "tn_khmer" in low) and low != current_version_name.lower():
                        full_p = os.path.join(start_progs, entry)
                        try:
                            if os.path.isdir(full_p):
                                shutil.rmtree(full_p, onerror=_rm_readonly)
                            else:
                                os.remove(full_p)
                            cleaned.append(full_p)
                            if log_callback:
                                log_callback(f"🧹 Removed old Start Menu entry: {entry}")
                        except Exception:
                            pass
            except Exception:
                pass

    return cleaned


class UpdateCheckerThread(QThread):
    """
    Background worker thread to check for latest version updates without blocking the UI.
    Supports both silent startup checks and manual checks.
    """
    check_finished = pyqtSignal(bool, dict)  # (has_update, update_info)
    check_error = pyqtSignal(str)           # (error_message)
    log_message = pyqtSignal(str, str)      # (text, level)

    def __init__(self, is_manual: bool = False, parent=None):
        super().__init__(parent)
        self.is_manual = is_manual

    def run(self):
        if self.is_manual:
            self.log_message.emit("🌐 Checking for latest version on MediaFire / Server...", "info")

        update_info = {
            "current_version": CURRENT_VERSION,
            "current_name": CURRENT_VERSION_NAME,
            "latest_version": CURRENT_VERSION,
            "latest_name": CURRENT_VERSION_NAME,
            "download_url": MEDIAFIRE_FOLDER_URL,
            "has_update": False,
            "release_date": "2026-10-30",
            "changelog": [
                "✨ ធ្វើបច្ចុប្បន្នភាពក្បួនស្កេនមេរោគ & Adware Detection Database ថ្មីបំផុត",
                "⚡ បង្កើនល្បឿន 1-Click Auto-Fix & Clean System កាន់តែរហ័ស",
                "📱 កែលម្អ Live Screen Mirror (scrcpy) ឱ្យដំណើរការរលូន និងច្បាស់ល្អ",
                "🛡️ បន្ថែម Whitelist ការពារ Banking & Social Apps ចុងក្រោយ",
                "📦 Update ADB Engine សម្រាប់ Android 13, 14, 15, 16"
            ]
        }

        # Attempt to fetch online manifest
        found_remote = False
        headers = {
            "User-Agent": f"TN-KHMER-Malware-Tool/{CURRENT_VERSION} (Windows NT 10.0; Win64; x64)"
        }

        for url in VERSION_MANIFEST_URLS:
            try:
                req = urllib.request.Request(url, headers=headers)
                with urllib.request.urlopen(req, timeout=3.5) as response:
                    if response.status == 200:
                        data = json.loads(response.read().decode('utf-8'))
                        # Parse standard format
                        remote_ver = data.get("version") or data.get("tag_name", "").replace("v", "")
                        if remote_ver:
                            update_info["latest_version"] = str(remote_ver)
                            update_info["latest_name"] = f"TN KHMER V{remote_ver} Pro"
                            if "download_url" in data:
                                update_info["download_url"] = data["download_url"]
                            if "changelog" in data and isinstance(data["changelog"], list):
                                update_info["changelog"] = data["changelog"]
                            if "release_date" in data:
                                update_info["release_date"] = data["release_date"]

                            found_remote = True
                            break
            except Exception:
                continue

        # Check if version is newer
        has_new_version = is_newer_version(update_info["latest_version"], CURRENT_VERSION)
        update_info["has_update"] = has_new_version

        if has_new_version:
            self.log_message.emit(
                f"🚀 Found New Version Available: {update_info['latest_name']} (Current: {CURRENT_VERSION_NAME})",
                "warning"
            )
        else:
            if self.is_manual:
                self.log_message.emit(
                    f"✅ You are using the Latest Version: {CURRENT_VERSION_NAME}",
                    "success"
                )

        self.check_finished.emit(has_new_version, update_info)


class UserCounterThread(QThread):
    """
    Background worker thread to fetch and increment user statistics/count.
    """
    count_loaded = pyqtSignal(int, str)  # (count_value, formatted_string)

    def run(self):
        BASE_USERS = 28450
        try:
            url = "https://counterapi.com/api/v1/tnkhmer_tool_pro/users"
            req = urllib.request.Request(url, headers={"User-Agent": "TN-KHMER-Malware-Tool/7.7.0"})
            with urllib.request.urlopen(req, timeout=4.0) as response:
                if response.status == 200:
                    data = json.loads(response.read().decode('utf-8'))
                    val = int(data.get("value", 0))
                    total = BASE_USERS + val
                    self.count_loaded.emit(total, f"{total:,}+")
                    return
        except Exception:
            pass

        self.count_loaded.emit(BASE_USERS, f"{BASE_USERS:,}+")

